{% apply spaceless %}
{# twig template #}
{#
   variables:
   - settings
   - config
   - theme_name
   - now_rfc822 e.g. 'Thu, 09 Oct 25 15:00:09 +0000'
   - board
   | - board.uri e.g. 'b'
   | - board.title
   - op : original post
   | - op.subject
   | - op.body : comment
   | - op.snippet : shortened body
   | - op.board_title
   | - op.time_rfc822
   | - op.files
   | | - op.files[N].computed_name
   | | - op.files[N].link : full url of the post
   | | - op.files[N].computed_thumb
   | | - op.files[N].computed_thumb_link : full url of the thumbnail
   - post_list : replies to op
   | - post_list[N] : the same attributes as `op` are available.
 #}
<?xml version="1.0" encoding="utf-8"?>
<rss xmlns:dc="http://purl.org/dc/elements/1.1/"
     version="2.0">
  <channel>
    <title>{{ op.subject|e }} - {{ op.board_title|e }}</title>
    <description>
      <![CDATA[{{ op.snippet }}]]>
    </description>
    <generator>Tinyboard {{ config.version }}, {{ theme_name|e }}</generator>
    <link>{{ op.link }}</link>
    <lastBuildDate>{{ now_rfc822 }}</lastBuildDate>
    {% for file in op.files %}
    <image>
      <url>{{ file.computed_thumb_link }}</url>
      <link>{{ file.file_link }}</link>
      <title>{{ file.computed_name|e }}</title>
    </image>
    {% endfor %}

    {% for post in post_list %}
    <item>
      <title>{{ post.subject|e }} - {{ post.board_title|e }}</title>
      <description>
	<![CDATA[{{ post.snippet }}]]>
      </description>
      <link>{{ post.link }}</link>
      <guid>{{ post.link }}{{ post.time }}</guid>
      <pubdate>{{ post.time_rfc822 }}</pubdate>
      {% for file in post.files %}
      <image>
	<url>{{ file.computed_thumb_link }}</url>
	<link>{{ file.file_link }}</link>
	<title>{{ file.computed_name|e }}</title>
      </image>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
{% endapply %}
