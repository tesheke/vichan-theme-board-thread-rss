{% apply spaceless %}
{# twig template #}
{#
   variables:
   - settings
   - config
   - theme_name
   - now_rfc822 e.g. 'Thu, 09 Oct 25 15:00:09 +0000'
   - board
   | - board.uri e.g. 'b'
   | - board.title
   | - board.link : full url of the board
   - post_list : replies to op
   | - post_list[N]
   | - post_list[N].subject
   | - post_list[N].body : comment
   | - post_list[N].snippet : shortened body
   | - post_list[N].board_title
   | - post_list[N].time_rfc822
   | - post_list[N].files
   | | - .files[N].computed_name
   | | - .files[N].link : full url of the post
   | | - .files[N].computed_thumb
   | | - .files[N].computed_thumb_link : full url of the thumbnail
 #}
<?xml version="1.0" encoding="utf-8"?>
<rss xmlns:dc="http://purl.org/dc/elements/1.1/"
     version="2.0">
  <channel>
    <title>{{ board.uri|e }} - {{ board.title|e }}</title>
    <description>
      <![CDATA[{{ board.subtitle }}]]>
    </description>
    <generator>Tinyboard {{ config.version }}, {{ theme_name|e }}</generator>
    <link>{{ board.link }}</link>
    <lastBuildDate>{{ now_rfc822 }}</lastBuildDate>

    {% for post in post_list %}
    <item>
      <title>{{ post.subject|e }} - {{ post.board_title|e }}</title>
      <description>
	<![CDATA[{{ post.snippet }}]]>
      </description>
      <link>{{ post.link }}</link>
      <guid>{{ post.link }}{{ post.time }}</guid>
      <pubdate>{{ post.time_rfc822 }}</pubdate>
      {% for file in post.files %}
      <image>
	<url>{{ file.computed_thumb_link }}</url>
	<link>{{ file.file_link }}</link>
	<title>{{ file.computed_name|e }}</title>
      </image>
      {% endfor %}
    </item>
    {% endfor %}
  </channel>
</rss>
{% endapply %}
